# Copy to .env (git-ignored). Never commit real values.
# `flask run` loads .env automatically; for scripts: set -a; source .env; set +a
RELAY_AI_PROVIDER=ollama      # mock | ollama | xai | anthropic | openai
RELAY_MODEL=gemma4:31b-cloud
# Ollama cloud API key: set it to call ollama.com directly (no local daemon).
# Leave empty to use a local Ollama at http://localhost:11434.
OLLAMA_API_KEY=
# RELAY_AI_BASE_URL=          # optional host override; /v1 is appended
RELAY_SECRET_KEY=change-me
