      "id": "k-dose-temp",
      "title": "Antiscalant Dose Follows Feed Temperature, Not the Vendor Curve",
      "type": "heuristic",
      "capability": {
        "id": "cap-dosing",
        "name": "Antiscalant Dosing Adjustment",
        "critical": true
      },
      "area": {
        "id": "area-dosing",
        "name": "Chemical Dosing",
        "href": "/blueprint?area=area-dosing"
      },
      "situation": "Setting antiscalant dose through the summer when feed temperature swings 6 °C between tide cycles.",
      "observed_signals": [
        "Feed temperature above 27 °C",
        "LSI of concentrate above +1.6",
        "Recovery held at 44%"
      ],
      "expert_reasoning": "The vendor projection assumes 25 °C. Calcium carbonate scaling risk climbs faster than the curve above 27 °C at this recovery.",
      "recommended_response": "Add 0.3 mg/L to the projected dose per 2 °C above 27 °C, cap at 3.6 mg/L. Re-run the projection weekly with actual feed chemistry.",
      "why_it_matters": "Last-stage scaling on Train 4 in August 2025 took three elements out of service.",
      "source": {
