    {
      "id": "k-sdi-before-dp",
      "title": "SDI Moves Before Differential Pressure",
      "type": "heuristic",
      "capability": {
        "id": "cap-fouling",
        "name": "Membrane Fouling Diagnosis",
        "critical": true
      },
      "area": {
        "id": "area-ro",
        "name": "Reverse Osmosis Operations",
        "href": "/blueprint?area=area-ro"
      },
      "situation": "Deciding whether first-stage fouling is starting before the ΔP alarm tells you.",
      "observed_signals": [
        "SDI15 at cartridge outlet creeping 0.2–0.3 per day",
        "First-stage ΔP still inside 1.8 bar limit",
        "Normalized permeate flow down 3–4% over a week"
      ],
      "expert_reasoning": "Colloidal load shows up in SDI 5–7 days before first-stage ΔP rises. By the time ΔP alarms, the lead elements are already caked.",
      "recommended_response": "Trend SDI daily, not weekly. Two consecutive days above 3.5 → inspect cartridges and book a CIP slot for the affected train.",
      "why_it_matters": "Avoids an unplanned CIP on a lead-element foul. Each unplanned CIP costs ~14 h of train downtime.",
      "source": null,
