        "id": "k-l2-probe",
        "title": "Line 2 Turbidity Probe Reads Low After Storms",
        "type": "expert_insight",
        "capability": {
          "id": "cap-turbidity",
          "name": "Intake Turbidity Response",
          "critical": true
        },
        "area": {
          "id": "area-intake",
          "name": "Intake & Pretreatment",
          "href": "/blueprint?area=area-intake"
        },
        "situation": "Interpreting Line 2 intake turbidity during and after heavy swell.",
        "observed_signals": [
          "Line 2 reads 3–6 NTU below Line 1 for the same swell",
          "Probe wiper cycle alarms within 48 h of a storm",
          "Grab sample disagrees with online reading by > 25%"
        ],
        "expert_reasoning": "The Line 2 probe sits in a low-flow pocket that fouls with biofilm after storms. It under-reads until cleaned.",
        "recommended_response": "Take a grab sample every 2 h during storm events. Treat Line 2 online value as a floor, not a reading.",
        "why_it_matters": "Under-reading is what lets the formal 20 NTU trigger fire late.",
        "source": {
          "label": "Line 2 intake turbidity event",
          "href": "/sessions/sess-l2"
        },
        "expert": {
